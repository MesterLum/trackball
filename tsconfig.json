{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@trackball/core": ["./packages/core/src/index.ts"],
      "@trackball/renderer-browser": ["./packages/renderer-browser/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.svelte", "vite.config.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "packages/core/dist"]
}
