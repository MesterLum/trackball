# direnv loads the locked Node.js 24 + just shell when entering this repository.
# Some macOS shells have Nix installed but do not include its profile in PATH.
if ! command -v nix >/dev/null 2>&1; then
  if [ -x /nix/var/nix/profiles/default/bin/nix ]; then
    PATH_add /nix/var/nix/profiles/default/bin
  else
    log_error "Nix is required. Install it from https://nixos.org/download/ and reopen your shell."
    return 1
  fi
fi
use flake
